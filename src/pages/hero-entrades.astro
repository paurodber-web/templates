  .hero[data-layout='llindar'] .hero-word, .hero[data-layout='refugi'] .hero-word, .hero[data-layout='linies'] .hero-word, .hero[data-layout='persiana'] .hero-word, .hero[data-layout='espai'] .hero-word { font-family: 'Plus Jakarta Sans', sans-serif; letter-spacing: -.055em; font-size: clamp(3.5rem, 9vw, 8.5rem); line-height: .98; }
  .hero[data-layout='llindar'] .hero-photo { inset: 14% 4% 14% 38%; }
