---
import '@fontsource/plus-jakarta-sans/latin-400.css';
import '@fontsource/plus-jakarta-sans/latin-ext-400.css';
import { IMG } from '../data';

const home = import.meta.env.BASE_URL;
const choices = [
  ['llum', 'Línia de llum'],
  ['oberta', 'Llar oberta'],
  ['capes', 'Capes de calma'],
  ['gest', 'El quart gest'],
  ['estanca', 'Una estança'],
  ['claror', 'Claror'],
  ['pausa', 'Pausa'],
  ['fil', 'El fil de casa'],
  ['recers', 'Recers'],
  ['horitzo', 'Horitzó'],
  ['llindar', 'Llindar'],
  ['refugi', 'Refugi'],
  ['linies', 'Línies'],
  ['persiana', 'Persiana'],
  ['espai', 'Espai'],
  ['alba', 'Alba'],
  ['niu', 'Niu'],
  ['ritme', 'Ritme'],
  ['traca', 'Traça'],
  ['sempre', 'Sempre'],
  ['portic', 'Pòrtic'],
  ['aigua', 'Aigua'],
  ['tessit', 'Teixit'],
  ['aire', 'Aire'],
  ['cadencia', 'Cadència'],
  ['serena', 'Serena'],
  ['interiors', 'Interiors'],
  ['clariana', 'Clariana'],
  ['portal', 'Portal'],
  ['primera', 'Primera llum'],
];
---
<!doctype html>
<html lang="ca">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Entrades · El Quart Desig</title>
    <meta name="description" content="Propostes d'entrada per a El Quart Desig." />
  </head>
  <body>
    <main>
      <section class="hero" aria-labelledby="hero-title">
        <div class="hero-photo" aria-hidden="true"><img src={IMG.hero} alt="" fetchpriority="high" /></div>
        <div class="hero-shade" aria-hidden="true"></div>
        <div class="hero-veil" aria-hidden="true"></div>
        <div class="hero-line" aria-hidden="true"></div>
        <header class="hero-header">
          <a class="hero-brand" href={home} aria-label="El Quart Desig, inici">EQD<span>·</span></a>
          <nav aria-label="Navegació principal">
            <a href={`${home}#serveis`}>Serveis</a>
            <a href={`${home}#sobre`}>Nosaltres</a>
            <a href={`${home}#contacte`}>Contacte</a>
            <a class="hero-button" href={`${home}#reserva`}>Parlem-ne <span aria-hidden="true">↗</span></a>
          </nav>
        </header>
        <h1 id="hero-title" class="sr-only">El Quart Desig. Cuidem els detalls perquè puguis gaudir de casa teva.</h1>
        <div class="hero-word hero-first" aria-hidden="true">EL QUART</div>
        <div class="hero-word hero-last" aria-hidden="true">DESIG</div>
        <div class="hero-bottom">
          <p class="hero-description"><span>Cura de la llar</span>Cuidem els detalls perquè puguis<br />gaudir de casa teva.</p>
          <div class="hero-actions">
            <a class="action-primary" href={`${home}#reserva`}>Reserva la teva neteja <span aria-hidden="true">↗</span></a>
            <a class="action-secondary" href={`${home}#serveis`}>Més informació <span aria-hidden="true">↓</span></a>
          </div>
        </div>
      </section>
    </main>
    <details class="chooser">
      <summary class="chooser-toggle"><span>Explora els dissenys</span><span class="chooser-current">01 / 30</span><span class="chooser-icon" aria-hidden="true">+</span></summary>
      <div class="chooser-content">
      <div class="chooser-heading"><span>Propostes d'entrada</span><span>01 — 30</span></div>
      <div class="chooser-buttons" role="group" aria-label="Escull una entrada">
        {choices.map(([id, label], index) => (
          <button type="button" data-choice={id} aria-pressed={index === 0 ? 'true' : 'false'}><span>{String(index + 1).padStart(2, '0')}</span>{label}</button>
        ))}
      </div>
      <p class="chooser-note" aria-live="polite">Línia de llum</p>
      </div>
    </details>
  </body>
</html>

<style>
  :global(*) { box-sizing: border-box; }
  :global(html), :global(body) { margin: 0; min-width: 320px; }
  :global(body) { font-family: 'Plus Jakarta Sans', sans-serif; background: #1b2336; }
  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; }
  .hero { position: relative; height: 100svh; min-height: 680px; overflow: hidden; background: #1b2336; color: #f7f1df; }
  .hero-photo, .hero-shade, .hero-veil { position: absolute; inset: 0; pointer-events: none; }
  .hero-photo { overflow: hidden; }
  .hero-photo img { display: block; width: 100%; height: 100%; object-fit: cover; }
  .hero-shade { background: linear-gradient(180deg, rgba(27, 35, 54, .65), rgba(27, 35, 54, .25) 42%, rgba(27, 35, 54, .7)); }
  .hero-veil { z-index: 2; background: #394d67; visibility: hidden; }
  .hero-line { position: absolute; z-index: 3; left: 4%; right: 4%; top: 50%; height: 1px; background: #f7f1df; visibility: hidden; transform-origin: left center; }
  .hero-header { position: absolute; z-index: 4; inset: 0 0 auto; display: flex; align-items: center; justify-content: space-between; padding: 34px 4%; }
  .hero-header a, .hero-bottom a { color: inherit; text-decoration: none; }
  .hero-brand { font-family: Georgia, serif; font-size: 20px; letter-spacing: -.08em; }
  .hero-brand span { color: #e1a88e; }
  nav { display: flex; align-items: center; gap: 30px; font-size: 13px; }
  nav a:not(.hero-button) { border-bottom: 1px solid transparent; padding-block: 8px; transition: border-color .2s ease; }
  @media (hover: hover) { nav a:hover { border-color: currentColor; } }
  .hero-button { padding: 14px 19px; background: #f7f1df; color: #1b2336 !important; }
  .hero-button span { margin-left: 12px; }
  .hero-word { position: absolute; z-index: 3; font-family: Georgia, 'Times New Roman', serif; font-size: clamp(4.5rem, 13vw, 12rem); font-weight: 400; line-height: .87; letter-spacing: -.035em; word-spacing: .18em; white-space: nowrap; }
  .hero-first { top: 18%; left: 4%; transform-origin: left center; }
  .hero-last { right: 4%; bottom: 12%; transform-origin: right center; }
  .hero-bottom { position: absolute; z-index: 4; left: 4%; right: 4%; bottom: 36px; display: flex; align-items: end; justify-content: space-between; gap: 24px; }
  .hero-description, .hero-place { margin: 0; font-size: 13px; line-height: 1.6; }
  .hero-description > span { display: block; margin-bottom: 12px; font-size: 11px; letter-spacing: .16em; text-transform: uppercase; }
  .hero-discover { display: inline-flex; align-items: center; gap: 12px; font-size: 13px; }
  .hero-discover span { display: grid; place-items: center; width: 40px; height: 40px; border: 1px solid rgba(255,255,255,.65); border-radius: 50%; font-size: 18px; }
  .hero-actions { display: flex; align-items: center; flex-wrap: wrap; gap: 12px; }
  .hero-actions a { display: inline-flex; align-items: center; justify-content: center; gap: 12px; min-height: 48px; padding: 12px 18px; font-size: 13px; line-height: 1.2; }
  .hero-actions .action-primary { background: #f7f1df; color: #1b2336; }
  .hero-actions .action-secondary { border: 1px solid rgba(247,241,223,.65); color: #f7f1df; }
  .hero-actions a span { font-size: 16px; }
  /* Cada propuesta termina en una composición distinta. */
  .hero[data-layout='llum'] .hero-first { top: 30%; left: 4%; }
  .hero[data-layout='llum'] .hero-last { top: calc(30% + clamp(4.5rem, 12vw, 11rem)); bottom: auto; left: 4%; right: auto; }
  .hero[data-layout='llum'] .hero-description { max-width: 270px; }
  .hero[data-layout='oberta'] .hero-first { top: 18%; left: 4%; }
  .hero[data-layout='oberta'] .hero-last { right: 4%; bottom: 12%; }
  .hero[data-layout='capes'] .hero-first,
  .hero[data-layout='capes'] .hero-last { left: 0; right: 0; width: max-content; max-width: 100%; margin-inline: auto; text-align: center; }
  .hero[data-layout='capes'] .hero-first { top: 29%; }
  .hero[data-layout='capes'] .hero-last { top: 51%; bottom: auto; }
  .hero[data-layout='capes'] .hero-bottom { justify-content: space-between; }
  .hero[data-layout='gest'] .hero-first { top: 20%; right: 4%; left: auto; }
  .hero[data-layout='gest'] .hero-last { left: 4%; right: auto; bottom: 20%; }
  .hero[data-layout='gest'] .hero-bottom { flex-direction: row-reverse; }
  .hero[data-layout='gest'] .hero-description { text-align: right; }
  .hero[data-layout='estanca'] .hero-photo { inset: 16% 30% 12% 4%; }
  .hero[data-layout='estanca'] .hero-shade { background: linear-gradient(90deg, rgba(17,24,21,.2), rgba(17,24,21,.05) 45%, rgba(17,24,21,.45)); }
  .hero[data-layout='estanca'] .hero-first { top: 27%; left: auto; right: 4%; }
  .hero[data-layout='estanca'] .hero-last { right: 4%; bottom: 22%; }
  .hero[data-layout='estanca'] .hero-place { color: #dce8e1; }
