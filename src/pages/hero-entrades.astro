      const arrivals: Record<string, { photo: Keyframe[]; first: Keyframe[]; last: Keyframe[]; delay: number }> = {
        portic: { photo: [{ opacity: 0, clipPath: 'inset(0 100% 0 0 round 18px)' }, { opacity: 1, clipPath: 'inset(0 0% 0 0 round 0px)' }], first: [{ opacity: 0, transform: 'translateX(-42px)' }, { opacity: 1, transform: 'translateX(0)' }], last: [{ opacity: 0, transform: 'translateX(-70px)' }, { opacity: 1, transform: 'translateX(0)' }], delay: 300 },
        aigua: { photo: [{ opacity: 0, clipPath: 'inset(50% 0 50% 0 round 28px)' }, { opacity: 1, clipPath: 'inset(0% 0 0% 0 round 0px)' }], first: [{ opacity: 0, transform: 'translateY(38px)' }, { opacity: 1, transform: 'translateY(0)' }], last: [{ opacity: 0, transform: 'translateY(-38px)' }, { opacity: 1, transform: 'translateY(0)' }], delay: 500 },
        tessit: { photo: [{ opacity: 0, clipPath: 'inset(0 0 0 100%)' }, { opacity: 1, clipPath: 'inset(0 0 0 0%)' }], first: [{ opacity: 0, transform: 'translateX(55px)' }, { opacity: 1, transform: 'translateX(0)' }], last: [{ opacity: 0, transform: 'translateX(25px)' }, { opacity: 1, transform: 'translateX(0)' }], delay: 450 },
        aire: { photo: [{ opacity: 0, clipPath: 'inset(100% 0 0 0)' }, { opacity: 1, clipPath: 'inset(0% 0 0 0)' }], first: [{ opacity: 0, transform: 'translateY(-40px)' }, { opacity: 1, transform: 'translateY(0)' }], last: [{ opacity: 0, transform: 'translateY(-20px)' }, { opacity: 1, transform: 'translateY(0)' }], delay: 800 },
        cadencia: { photo: [{ opacity: 0, transform: 'scale(1.07)' }, { opacity: 1, transform: 'scale(1)' }], first: [{ opacity: 0, clipPath: 'inset(0 0 100% 0)' }, { opacity: 1, clipPath: 'inset(0 0 0% 0)' }], last: [{ opacity: 0, clipPath: 'inset(0 0 100% 0)' }, { opacity: 1, clipPath: 'inset(0 0 0% 0)' }], delay: 250 },
        serena: { photo: [{ opacity: 0, clipPath: 'inset(0 0 100% 0 round 20px)' }, { opacity: 1, clipPath: 'inset(0 0 0% 0 round 0px)' }], first: [{ opacity: 0, transform: 'translateY(55px)' }, { opacity: 1, transform: 'translateY(0)' }], last: [{ opacity: 0, transform: 'translateY(55px)' }, { opacity: 1, transform: 'translateY(0)' }], delay: 950 },
        interiors: { photo: [{ opacity: 0, clipPath: 'inset(18% 18% 18% 18% round 28px)' }, { opacity: 1, clipPath: 'inset(0% 0% 0% 0% round 0px)' }], first: [{ opacity: 0, transform: 'translateX(-45px)' }, { opacity: 1, transform: 'translateX(0)' }], last: [{ opacity: 0, transform: 'translateX(45px)' }, { opacity: 1, transform: 'translateX(0)' }], delay: 300 },
        clariana: { photo: [{ opacity: 0, clipPath: 'inset(0 0 0 100%)' }, { opacity: 1, clipPath: 'inset(0 0 0 0%)' }], first: [{ opacity: 0, transform: 'translateY(-35px)' }, { opacity: 1, transform: 'translateY(0)' }], last: [{ opacity: 0, transform: 'translateY(35px)' }, { opacity: 1, transform: 'translateY(0)' }], delay: 700 },
        portal: { photo: [{ opacity: 0, clipPath: 'inset(50% 50% 50% 50% round 16px)' }, { opacity: 1, clipPath: 'inset(0% 0% 0% 0% round 0px)' }], first: [{ opacity: 0, transform: 'translateX(-40px)' }, { opacity: 1, transform: 'translateX(0)' }], last: [{ opacity: 0, transform: 'translateY(40px)' }, { opacity: 1, transform: 'translateY(0)' }], delay: 450 },
        primera: { photo: [{ opacity: 0, clipPath: 'inset(100% 0 0 0)' }, { opacity: 1, clipPath: 'inset(0% 0 0 0)' }], first: [{ opacity: 0, transform: 'translateY(25px)' }, { opacity: 1, transform: 'translateY(0)' }], last: [{ opacity: 0, transform: 'translateY(25px)' }, { opacity: 1, transform: 'translateY(0)' }], delay: 950 },
      };
      const scene = arrivals[id];
      if (!scene) return;
      image(scene.photo, 2200, scene.delay);
      word(first, scene.first, 1350, 650);
      word(last, scene.last, 1350, 900);
      dim(1000); ui(2200);
    }
  }

  buttons.forEach(button => button.addEventListener('click', () => {
    buttons.forEach(item => item.setAttribute('aria-pressed', String(item === button)));
    note.textContent = button.textContent?.replace(/^\s*\d+/, '').trim() || '';
    current.textContent = `${String(Array.from(buttons).indexOf(button) + 1).padStart(2, '0')} / ${buttons.length}`;
    chooser.open = false;
    play(button.dataset.choice || 'llum');
  }));
  play('llum');
</script>
