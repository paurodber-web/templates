/* El selector queda ancorat a la cantonada de cada secció. */
.hero-stage{position:relative}
.gallery-bar,.section-selector{position:absolute;top:auto;left:auto;right:18px;bottom:18px;transform:none;width:auto;max-width:calc(100% - 36px);padding:0;background:none;overflow:visible;z-index:20}
.selector-toggle,.selector-close{display:grid;place-items:center;border:0;cursor:pointer}
.selector-toggle{width:42px;height:42px;margin-left:auto;background:#243746;color:#fffdf8;border-radius:4px}
.selector-toggle span,.selector-toggle span::before,.selector-toggle span::after{display:block;width:19px;height:2px;background:currentColor;position:relative}
.selector-toggle span::before,.selector-toggle span::after{content:'';position:absolute;left:0}
.selector-toggle span::before{top:-6px}.selector-toggle span::after{top:6px}
.selector-popover{position:absolute;right:0;bottom:52px;width:min(300px,calc(100vw - 36px));padding:12px;background:#fffdf8;color:#243746;border:1px solid #d8c2a7;box-shadow:0 8px 24px #24374626}
.selector-popover[hidden]{display:none}
.selector-close{width:34px;height:34px;margin-left:auto;background:transparent;color:#243746;font-size:24px;line-height:1}
.selector-popover .switcher,.selector-popover .manifest-tabs{display:flex;flex-wrap:wrap;overflow:visible;gap:4px;max-width:none}
