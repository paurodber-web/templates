  <script is:inline>
const groups = document.querySelectorAll('[data-section]');
groups.forEach(group => {
  const tabs = [...group.querySelectorAll('[role="tab"]')];
  const tablist = group.querySelector('[role="tablist"]');
  const toggle = document.createElement('button');
  const popover = document.createElement('div');
  const close = document.createElement('button');
  const popoverId = `selector-${group.dataset.section}`;
  toggle.type = close.type = 'button';
  toggle.className = 'selector-toggle';
  toggle.setAttribute('aria-label', 'Obre el selector de dissenys');
  toggle.setAttribute('aria-expanded', 'false');
  toggle.setAttribute('aria-controls', popoverId);
  toggle.innerHTML = '<span aria-hidden="true"></span>';
  popover.className = 'selector-popover';
  popover.id = popoverId;
  popover.hidden = true;
  close.className = 'selector-close';
  close.setAttribute('aria-label', 'Tanca el selector de dissenys');
  close.textContent = '×';
  group.append(toggle, popover);
  popover.append(close, tablist);
  toggle.addEventListener('click', () => {
    popover.hidden = false;
    toggle.setAttribute('aria-expanded', 'true');
    close.focus();
  });
  close.addEventListener('click', () => {
    popover.hidden = true;
    toggle.setAttribute('aria-expanded', 'false');
    toggle.focus();
  });
  const key = `el-sete-cel:${group.dataset.section}`;
  function select(tab, focus = false, save = true) {
    tabs.forEach(item => {
      const selected = item === tab;
      item.setAttribute('aria-selected', String(selected));
      item.tabIndex = selected ? 0 : -1;
      document.getElementById(item.getAttribute('aria-controls')).hidden = !selected;
    });
    if (save) { try { localStorage.setItem(key, tab.id); } catch {} }
    if (focus) tab.focus();
  }
  let saved; try { saved = localStorage.getItem(key); } catch {}
  select(group.dataset.section === 'manifest' ? tabs[0] : (tabs.find(tab => tab.id === saved) || tabs[0]), false, false);
  tabs.forEach((tab, index) => {
    tab.addEventListener('click', () => select(tab));
    tab.addEventListener('keydown', event => {
      if (!['ArrowLeft', 'ArrowRight', 'Home', 'End'].includes(event.key)) return;
      event.preventDefault();
      const next = event.key === 'Home' ? 0 : event.key === 'End' ? tabs.length - 1 : (index + (event.key === 'ArrowRight' ? 1 : -1) + tabs.length) % tabs.length;
      select(tabs[next], true);
    });
  });
});

document.querySelectorAll('[data-service-tabs]').forEach(container => {
  const tabs = [...container.querySelectorAll('[role="tab"]')];
  function activate(tab, focus = false) {
    tabs.forEach(item => {
      const selected = item === tab;
      item.setAttribute('aria-selected', String(selected));
      item.tabIndex = selected ? 0 : -1;
      document.getElementById(item.getAttribute('aria-controls')).hidden = !selected;
    });
    const scene = container.closest('.concept-room')?.querySelector('.concept-room-scene');
    if (scene && tab.dataset.serviceImage) scene.style.backgroundImage = 'url("' + tab.dataset.serviceImage + '")';
    if (focus) tab.focus();
  }
  tabs.forEach((tab, index) => {
    tab.addEventListener('click', () => activate(tab));
    tab.addEventListener('keydown', event => {
      if (!['ArrowUp', 'ArrowDown', 'ArrowLeft', 'ArrowRight', 'Home', 'End'].includes(event.key)) return;
      event.preventDefault();
      const next = event.key === 'Home' ? 0 : event.key === 'End' ? tabs.length - 1 : (index + (event.key === 'ArrowDown' || event.key === 'ArrowRight' ? 1 : -1) + tabs.length) % tabs.length;
      activate(tabs[next], true);
    });
  });
});

document.querySelectorAll('[data-scroll-services]').forEach(container => {
  const buttons = [...container.querySelectorAll('[data-service-target]')];
  const cards = buttons.map(button => document.getElementById(button.dataset.serviceTarget));
  const mark = index => buttons.forEach((button, i) => button.setAttribute('aria-current', String(i === index)));
  cards.forEach(card => { card.hidden = false; });
  buttons.forEach((button, index) => button.addEventListener('click', () => {
    mark(index);
    const target = Math.max(0, window.scrollY + cards[index].getBoundingClientRect().top - (window.innerHeight - cards[index].offsetHeight) / 2);
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) { window.scrollTo(0, target); return; }
    const start = window.scrollY, distance = target - start;
    const duration = Math.min(1000, Math.max(500, Math.abs(distance) * .65));
    const began = performance.now();
    function step(now) {
      const t = Math.min(1, (now - began) / duration);
      const eased = t < .5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2;
      window.scrollTo(0, start + distance * eased);
      if (t < 1) requestAnimationFrame(step);
    }
    requestAnimationFrame(step);
  }));
  if ('IntersectionObserver' in window) {
    const observer = new IntersectionObserver(entries => {
      const visible = entries.filter(entry => entry.isIntersecting).sort((a,b) => b.intersectionRatio-a.intersectionRatio)[0];
      if (visible) mark(cards.indexOf(visible.target));
    }, {rootMargin:'-15% 0px -35% 0px', threshold:[0,.2,.5]});
    cards.forEach(card => observer.observe(card));
  }
});
document.querySelectorAll('.hero').forEach(panel => {
  let contentIndex = 0;
  panel.querySelectorAll('.reveal').forEach(element => {
    const isHeader = element.classList.contains('site-header');
    const isFooter = element.matches('.one-bottom, .two-caption, .three-footer, .four-footer, .five-footer, .new-index');
    element.style.setProperty('--reveal-delay', `${isHeader ? 1050 : isFooter ? 1200 : Math.min(contentIndex++ * 160, 640)}ms`);
  });
});


document.querySelectorAll('[data-service-tabs]').forEach(container => {
  const buttons = [...container.querySelectorAll('[data-service-choice]')];
  const details = [...container.querySelectorAll('[data-service-detail]')];
  buttons.forEach(button => button.addEventListener('click', () => {
    buttons.forEach(item => item.setAttribute('aria-pressed', String(item === button)));
    details.forEach(detail => { detail.hidden = detail.dataset.serviceDetail !== button.dataset.serviceChoice; });
  }));
});
if ('IntersectionObserver' in window && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
  const targets = document.querySelectorAll('[data-service-reveal]');
  const observer = new IntersectionObserver(entries => entries.forEach(entry => {
    if (entry.isIntersecting) { entry.target.classList.add('is-visible'); observer.unobserve(entry.target); }
  }), { threshold: .1 });
  document.documentElement.classList.add('js-service-motion');
  targets.forEach(target => observer.observe(target));
}


document.querySelectorAll('[data-compare-picker]').forEach(picker => {
  const buttons = [...picker.querySelectorAll('[data-compare-option]')];
  const results = [...picker.querySelectorAll('[data-compare-result]')];
  buttons.forEach(button => button.addEventListener('click', () => {
    buttons.forEach(item => item.setAttribute('aria-pressed', String(item === button)));
    results.forEach(result => { result.hidden = result.dataset.compareResult !== button.dataset.compareOption; });
  }));
});


document.querySelectorAll('[data-co-picker]').forEach(picker => {
  const buttons = [...picker.querySelectorAll('[data-co-option]')];
  const results = [...picker.querySelectorAll('[data-co-result]')];
  buttons.forEach(button => button.addEventListener('click', () => {
    buttons.forEach(item => item.setAttribute('aria-pressed', String(item === button)));
    results.forEach(result => { result.hidden = result.dataset.coResult !== button.dataset.coOption; });
  }));
});


document.querySelectorAll('[data-cmp-picker]').forEach(picker => {
  const buttons = [...picker.querySelectorAll('[data-cmp-option]')];
  const results = [...picker.querySelectorAll('[data-cmp-result]')];
  buttons.forEach(button => button.addEventListener('click', () => {
    buttons.forEach(item => item.setAttribute('aria-pressed', String(item === button)));
    results.forEach(result => { result.hidden = result.dataset.cmpResult !== button.dataset.cmpOption; });
  }));
});

