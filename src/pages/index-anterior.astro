/* Cartes 8-15: paper, sobre, postal, segell, capçalera */
:root{--paper:#FFFDF8;--ink:#243746;--ink-soft:#68645F;--sand:#E9E3DA;--sand-deep:#D8C2A7;--shadow:0 1px 2px rgba(36,55,70,.06),0 18px 40px -12px rgba(36,55,70,.18)}
.lt .letter-layout{position:relative;margin:auto;text-align:left}
.lt .letter-content{max-width:none;text-align:left}
.lt .letter-content p{max-width:560px}
.lt .letter-greeting{font-size:clamp(26px,3vw,40px);line-height:1.25;margin-bottom:28px;max-width:none}
.lt .letter-signoff{margin-top:34px}

/* 8 · sobre obert */
.lt8-wrap{max-width:820px}
.lt8-flap{height:clamp(70px,10vw,120px);background:var(--sand-deep);clip-path:polygon(50% 0,0 100%,100% 100%)}
.lt8-body{background:var(--sand);padding:0 clamp(18px,5vw,64px) clamp(34px,5vw,64px)}
.lt8-body .letter-content{background:var(--paper);box-shadow:var(--shadow);padding:clamp(32px,6vw,68px);margin-top:calc(-1 * clamp(36px,5vw,64px));position:relative}


/* 9 · postal */
.lt9-card{max-width:980px;display:grid;grid-template-columns:minmax(0,.9fr) minmax(0,1.1fr);background:var(--paper);box-shadow:var(--shadow);border:1px solid #ece3d4}
.lt9-photo{padding:clamp(14px,2vw,22px)}
.lt9-photo div{background-color:var(--sand);height:100%;min-height:380px;background-size:cover;background-position:center}
.lt9-text{position:relative;padding:clamp(30px,4.5vw,56px) clamp(24px,4vw,52px);border-left:1px dashed var(--sand-deep)}
.lt9-stamp{position:absolute;top:22px;right:22px;width:58px;height:70px;border:1px dashed var(--ink-soft);display:grid;place-items:center;font:italic 30px Georgia,serif;color:var(--ink-soft);outline:5px solid var(--paper);transform:rotate(3deg)}
.lt9-text .letter-greeting{margin-top:52px;font-size:clamp(23px,2.4vw,32px)}
.lt9-lines{margin-top:36px;display:grid;gap:16px;max-width:300px}.lt9-lines i{display:block;height:1px;background:var(--sand-deep)}

/* 10 · paper blau amb segell */
.lt10-paper{max-width:760px;background:var(--ink);color:#F7F5F0;padding:clamp(44px,7vw,92px) clamp(28px,7vw,92px) clamp(70px,8vw,100px);text-align:center;box-shadow:var(--shadow)}
.lt10-paper:before{content:'';position:absolute;inset:14px;border:1px solid rgba(216,194,167,.5);pointer-events:none}
.lt10-paper:after{content:'';position:absolute;inset:20px;border:1px solid rgba(216,194,167,.22);pointer-events:none}
.lt10-paper .letter-content,.lt10-paper .letter-content p{text-align:center;margin-left:auto;margin-right:auto}
.lt10-paper .letter-content p{color:#d9dde0}
.lt10-paper .letter-greeting{color:#F7F5F0}
.lt10-paper .letter-signoff{color:#b9c1c8}.lt10-paper .letter-signoff span{color:#F7F5F0}
.lt10-seal{position:absolute;left:50%;bottom:0;transform:translate(-50%,50%);width:84px;height:84px;border-radius:50% 46% 52% 48%/48% 52% 46% 50%;background:radial-gradient(circle at 35% 30%,#a85252,#7d3a3a 60%,#642d2d);display:grid;place-items:center;box-shadow:0 8px 18px -4px rgba(0,0,0,.4)}
.lt10-seal:before{content:'';position:absolute;inset:9px;border-radius:50%;border:1px solid rgba(255,230,220,.45)}
.lt10-seal span{font:italic 34px Georgia,serif;color:#f1d9d0;text-shadow:0 1px 0 rgba(0,0,0,.3)}
.lt-10:not([hidden]){padding-bottom:calc(var(--section-space) + 40px)}

/* 11 · paper pautat */
.lt11-sheet{max-width:700px;background-color:var(--paper);background-image:repeating-linear-gradient(to bottom,transparent 0 35px,rgba(36,55,70,.1) 35px 36px);background-position:0 0;box-shadow:var(--shadow);padding:72px clamp(26px,6vw,70px) 38px clamp(60px,10vw,110px)}
.lt11-sheet:before{content:'';position:absolute;top:0;bottom:0;left:clamp(44px,7vw,84px);width:1px;background:#dcaaa3}
.lt11-tape{position:absolute;top:-14px;left:50%;width:120px;height:32px;transform:translateX(-50%) rotate(-2deg);background:rgba(216,194,167,.7);box-shadow:0 1px 3px rgba(0,0,0,.08)}
.lt11-sheet .letter-content p:not(.letter-greeting){font-size:16px;line-height:36px;margin:0 0 36px}
.lt11-sheet .letter-greeting{font-size:clamp(26px,3vw,36px);line-height:72px;margin:0}
.lt11-sheet .letter-signoff{margin:0;line-height:36px;font-size:14px}.lt11-sheet .letter-signoff span{margin-top:0;line-height:36px;font-size:26px}

/* 12 · caplletra */
.lt12-wrap{max-width:900px;display:grid;grid-template-columns:minmax(80px,.35fr) minmax(0,1.65fr);gap:clamp(24px,6vw,80px);align-items:start}
.lt12-side{border-top:1px solid var(--ink);padding-top:14px;font:italic clamp(90px,12vw,170px)/.85 Georgia,serif;color:var(--sand-deep)}
.lt12-wrap .letter-content{border-top:1px solid var(--ink);padding-top:34px;border-bottom:1px solid var(--sand-deep);padding-bottom:44px}
.lt12-wrap .letter-content p:nth-child(2)::first-letter{float:left;font:clamp(60px,6vw,84px)/.8 Georgia,serif;color:var(--ink);padding:8px 14px 0 0}

/* 13 · paper de capçalera */
.lt13-paper{max-width:760px;background:var(--paper);box-shadow:var(--shadow);padding:clamp(34px,5vw,60px) clamp(28px,6vw,80px) 28px}
.lt13-head{text-align:center;padding-bottom:26px;border-bottom:3px double var(--sand-deep);margin-bottom:46px}
.lt13-brand{font-size:28px;letter-spacing:-.045em;font-weight:300;color:var(--ink)}.lt13-brand b{font-weight:500}
.lt13-foot{display:flex;justify-content:space-between;gap:16px;flex-wrap:wrap;margin-top:50px;padding-top:18px;border-top:1px solid var(--sand-deep);font-size:12px;color:var(--ink-soft)}

/* 14 · foto + full */
.lt14-scene{max-width:1100px;min-height:640px;background-size:cover;background-position:center;padding:clamp(24px,5vw,64px);display:flex;align-items:center;justify-content:flex-end}
.lt14-scene:before{content:'';position:absolute;inset:0;background:linear-gradient(90deg,rgba(36,55,70,.05),rgba(36,55,70,.35))}
.lt14-sheet{position:relative;width:min(540px,100%);background:var(--paper);padding:clamp(30px,5vw,58px);box-shadow:0 30px 60px -20px rgba(0,0,0,.45);transform:rotate(-1deg)}

/* 15 · fulls apilats */
.lt15-stack{max-width:700px;isolation:isolate}
.lt15-sheet .letter-greeting{font-size:clamp(23px,2.5vw,32px);line-height:1.3}.lt15-sheet{position:relative;background:var(--paper);border:1px solid #ece3d4;padding:clamp(34px,6vw,70px);box-shadow:var(--shadow)}
.lt15-stack:before,.lt15-stack:after{content:'';position:absolute;inset:0;background:var(--paper);border:1px solid #e6dccb;box-shadow:0 8px 20px -10px rgba(36,55,70,.2);z-index:-1}
.lt15-stack:before{transform:rotate(-2.4deg)}.lt15-stack:after{transform:rotate(1.8deg);background:#f7f1e6}
.lt15-clip{position:absolute;z-index:3;top:-22px;left:clamp(26px,6vw,64px);width:22px;height:74px;border:3px solid #9a948c;border-radius:12px}
.lt15-clip:after{content:'';position:absolute;left:3px;right:3px;top:14px;bottom:-4px;border:3px solid #9a948c;border-radius:8px}

@media(max-width:760px){
  .lt9-card{grid-template-columns:1fr}.lt9-photo div{min-height:240px}.lt9-text{border-left:0;border-top:1px dashed var(--sand-deep)}
  .lt12-wrap{grid-template-columns:1fr;gap:20px}.lt12-side{font-size:80px;border-top:0;padding:0}
  .lt14-scene{min-height:0;justify-content:center}.lt14-sheet{transform:none}
  .lt15-stack{width:94%}
}


