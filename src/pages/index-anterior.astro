/* Selectors flotants: no ocupen espai dins de les seccions. */
.gallery-bar{position:absolute;top:10px;left:50%;transform:translateX(-50%);width:max-content;max-width:calc(100% - 28px);min-height:0;padding:0;background:rgba(25,42,54,.9);border-radius:3px;z-index:10}
.gallery-title,.switcher button span,.section-selector>span{display:none}
.switcher{display:flex;max-width:100%;min-height:0;overflow-x:auto}
.switcher button{flex:none;padding:10px 12px}
.hero .site-header{height:100px;padding-top:0}
.manifesto{position:relative}
.section-selector{position:absolute;z-index:10;top:10px;left:50%;transform:translateX(-50%);width:max-content;max-width:calc(100% - 28px);min-height:0;padding:0;border:0;background:#f7f5f0;display:block}
